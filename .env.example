# Copy to .env and fill in. Values left empty, as ***REMOVED*** or as your-* are treated as unset.

# --- branding (shown in the UI; leave unset for a neutral placeholder) ---
ORG_NAME=***REMOVED***
AUTHOR_INFO=***REMOVED***
BRAND_LOGO_HEADER=***REMOVED***          # png/webp/jpg path, relative to the repo root or absolute
BRAND_LOGO_FOOTER_LIGHT=***REMOVED***
BRAND_LOGO_FOOTER_DARK=***REMOVED***

# --- chat providers: a provider without a key is hidden from the UI ---
CHAT_PROVIDER=openai
# local vLLM, e.g. http://127.0.0.1:8000/v1 (leave empty to hide the Qwen option)
QWEN_BASE_URL=
OPENAI_API_KEY=***REMOVED***
OPENAI_CHAT_MODEL=gpt-4.1-mini,gpt-5.4-mini   # comma-separated list; the first is the default
GEMINI_API_KEY=***REMOVED***
GEMINI_CHAT_MODEL=gemini-3.5-flash

# --- OCR: mineru (local) or gemini (uploads page images to Google; uses GEMINI_API_KEY) ---
OCR_BACKEND=mineru
GEMINI_OCR_MODEL=gemini-3.5-flash

# --- access control: empty APP_PASSWORD = no login (fine on localhost/tailnet; set one before a public URL) ---
APP_USER=***REMOVED***
# leave empty for passwordless
APP_PASSWORD=
MAX_DOCUMENTS=200
APP_SECRET=***REMOVED***   # optional: signs session tokens (default: derived from APP_PASSWORD)
# origin(s) of a separately hosted UI, comma-separated, e.g. https://name.github.io (empty = same origin only)
ALLOWED_ORIGINS=
TRUST_PROXY=0                  # 1 behind Cloudflare/nginx/Tailscale Funnel so rate limits use the real client IP

# --- runtime ---
RAG_DEVICE=cuda

# --- extra chat endpoints added from Cài đặt (the server calls the URL it is given: enable only on a trusted network, with APP_PASSWORD set) ---
ALLOW_CUSTOM_ENDPOINTS=1

# --- optional intent classifier: a small OpenAI-compatible model that labels each question before retrieval ---
# e.g. http://127.0.0.1:8100/v1
INTENT_BASE_URL=
INTENT_MODEL=
INTENT_API_KEY=

# seconds without a response byte before a model call fails
LLM_TIMEOUT=15
