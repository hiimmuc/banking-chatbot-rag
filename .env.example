# Copy to .env and fill in. Values left empty, as ***REMOVED*** or as your-* are treated as unset.

# --- branding (shown in the UI; leave unset for a neutral placeholder) ---
ORG_NAME=***REMOVED***
AUTHOR_INFO=***REMOVED***
BRAND_LOGO_HEADER=***REMOVED***          # png/webp/jpg path, relative to the repo root or absolute
BRAND_LOGO_FOOTER_LIGHT=***REMOVED***
BRAND_LOGO_FOOTER_DARK=***REMOVED***

# --- chat providers: a provider without a key is hidden from the UI ---
CHAT_PROVIDER=qwen
QWEN_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.5-flash

# --- OCR: mineru (local) or gemini (uploads page images to Google; uses GEMINI_API_KEY) ---
OCR_BACKEND=mineru
GEMINI_OCR_MODEL=gemini-3.5-flash

# --- access control: empty APP_PASSWORD = no login (fine on localhost/tailnet; set one before a public URL) ---
APP_USER=your-username
APP_PASSWORD=your-password   # leave empty for passwordless
MAX_DOCUMENTS=200
APP_SECRET=your-random-secret   # optional: signs session tokens (default: derived from APP_PASSWORD)
ALLOWED_ORIGINS=               # origin(s) of a separately hosted UI, comma-separated, e.g. https://name.github.io (empty = same origin only)
TRUST_PROXY=0                  # 1 behind Cloudflare/nginx/Tailscale Funnel so rate limits use the real client IP

# --- runtime ---
RAG_DEVICE=cuda
