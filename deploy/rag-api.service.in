[Unit]
Description=Banking Docs RAG API
After=network-online.target docker.service

[Service]
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
